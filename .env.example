ASA_PRODUCTS_PATH=data/products.json
ASA_REVIEWS_PATH=data/reviews.json
ASA_TOP_K=10
ASA_DB_PATH=data/shop.db
#LLM_PROVIDER=none
LLM_TIMEOUT_S=60

# NVIDIA NIM:
# LLM_PROVIDER=nim
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-
# LLM_MODEL=openai/gpt-oss-20b

# OpenRouter:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-
# LLM_MODEL=minimax/minimax-m3:free

# Retrieval variant: bm25 | semantic | hybrid (hybrid fuses BM25 + semantic via RRF)
ASA_RETRIEVAL=bm25
ASA_RERANK=0
ASA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ASA_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ASA_RRF_K=60
ASA_RERANK_TOP_N=20