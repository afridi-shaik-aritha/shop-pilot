ASA_PRODUCTS_PATH=data/products.json
ASA_REVIEWS_PATH=data/reviews.json
ASA_TOP_K=10
ASA_DB_PATH=data/shop.db
#LLM_PROVIDER=none
LLM_TIMEOUT_S=60

# NVIDIA NIM:
# LLM_PROVIDER=nim
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-
# LLM_MODEL=openai/gpt-oss-20b

# OpenRouter:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-
# LLM_MODEL=minimax/minimax-m3:free

# LM Studio (local server: start it in LM Studio with "Serve on local network"):
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=qwen2.5-7b-instruct
# Note: LM Studio accepts any non-empty key; the model must match one loaded
# in LM Studio (see its server panel for the exact id).

# Deep Infra (OpenAI-compatible endpoint):
# LLM_PROVIDER=deepinfra
# LLM_BASE_URL=https://api.deepinfra.com/v1/openai
# LLM_API_KEY=
# LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Retrieval variant: bm25 | semantic | hybrid (hybrid fuses BM25 + semantic via RRF)
ASA_RETRIEVAL=bm25
ASA_RERANK=0
ASA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ASA_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ASA_RRF_K=60
ASA_RERANK_TOP_N=20